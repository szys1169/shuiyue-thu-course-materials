main:main.cpp sum.cpp
	g++ sum.cpp main.cpp -o main

debug:main.cpp sum.cpp
	g++ -DDEBUG=1 sum.cpp main.cpp -o main

minus:main.cpp sum.cpp minus.cpp
	g++ -DAAAA=1 sum.cpp main.cpp minus.cpp -o main

product:main.cpp sum.cpp product.cpp
	g++ -DBBBBB=1 sum.cpp main.cpp product.cpp -o main

divide:main.cpp sum.cpp divide.cpp
	g++ -DCCCCC=1 sum.cpp main.cpp divide.cpp -o main

clean:
	del *.o main main.exe