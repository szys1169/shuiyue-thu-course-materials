import numpy as np

def Maxdt_t(t, last_t):
    dt_t = np.abs(t - last_t) / np.abs(last_t)
    return np.max(dt_t)

def main():
    dx = 0.08
    dy = 0.08
    q = 1500
    h = 40
    langda = 45
    tf = 25
    e = 0.000001
    maxdt_t = 1
    k = 0

    # 初始化
    t = np.zeros((4, 6))
    last_t = -np.ones((4, 6))

    while k < 1000 and maxdt_t > e:
        last_t = np.copy(t)

        # 开始迭代计算
        t[0, :] = 200
        for j in range(1, 5):
            t[0, j] = 0.25 * (t[0, j-1] + t[0, j+1] + 2 * t[1, j])
        t[0, 5] = 0.5 * (t[0, 4] + t[1, 5]) + q * dx / (2 * langda)

        for i in range(1, 3):
            for j in range(1, 5):
                t[i, j] = 0.25 * (t[i, j-1] + t[i, j+1] + t[i-1, j] + t[i+1, j])
            t[1, 5] = 0.25 * (t[0, 5] + t[2, 5] + 2 * t[1, 4]) + q * dx / (2 * langda)
            t[2, 5] = 0.25 * (t[1, 5] + t[3, 5] + 2 * t[2, 4]) + q * dx / (2 * langda)

        for j in range(1, 5):
            t[3, j] = (langda * (2 * t[3, j] + t[4, j-1] + t[4, j+1]) + 2 * h * dy * tf) / (4 * langda + 2 * h * dy)
        t[3, 5] = (langda * (t[3, 4] + t[2, 5]) + h * dy * tf + q * dx) / (2 * langda + h * dy)

        maxdt_t = Maxdt_t(t, last_t)
        k += 1

    print(k)
    print(maxdt_t)
    print(t)
